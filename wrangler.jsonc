{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "amigs-voice",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "amigs-voice",
      "database_id": "95380514-d56a-41f2-88f8-278c32902e0d"
    }
  ],
  "observability": {
    "enabled": true
  }
}
